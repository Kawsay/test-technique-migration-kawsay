#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

bundle install

# La base de développement, puis celle des tests (APP_ENV=test), que rspec attend déjà créée.
if ! bundle exec rake db:setup || ! APP_ENV=test bundle exec rake db:setup; then
  cat <<'MSG'

Connexion à PostgreSQL impossible. Deux solutions :
  - Créer un rôle pour votre utilisateur système (Linux) :
      sudo -u postgres createuser --superuser "$USER"
  - Ou renseigner vos identifiants dans .env (PGUSER, PGPASSWORD, PGHOST)
Puis relancez bin/setup.
MSG
  exit 1
fi

echo "Setup terminé."
